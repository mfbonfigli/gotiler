---
// A screenshot in a rounded panel, served at the widths the page needs, with
// the credits passed as children shown under it.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
}

const { src, alt } = Astro.props;
const widths = [640, 960, 1280, src.width].filter((width) => width <= src.width);
---

<figure class="screenshot not-content">
	<Image src={src} alt={alt} widths={widths} sizes="(min-width: 60rem) 40rem, 100vw" />
	{
		Astro.slots.has('default') && (
			<figcaption>
				<slot />
			</figcaption>
		)
	}
</figure>

<style>
	.screenshot {
		margin: 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.5);
	}

	figcaption {
		margin-top: 0.6rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		text-align: right;
	}

	/* MDX wraps the credits in a paragraph */
	figcaption :global(p) {
		margin: 0;
	}

	figcaption :global(a) {
		color: inherit;
	}
</style>
