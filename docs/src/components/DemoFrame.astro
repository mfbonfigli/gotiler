---
// The live demo, a CesiumJS viewer hosted apart from the docs, in a frame that
// fills the window under the top bar, from edge to edge: the page around it
// does not scroll, and its title is left to screen readers. It is meant to be
// the only content of a splash page.
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<iframe class="demo-frame not-content" src={src} title={title} allow="fullscreen" allowfullscreen></iframe>

<style>
	/* The main column takes the window's height under the top bar, and the
	   panel that holds the frame all of it. The site footer would make the
	   page scroll, so this page goes without it. */
	:global(main:has(.demo-frame)) {
		display: flex;
		flex-direction: column;
		height: calc(100svh - var(--sl-nav-height));
		padding-bottom: 0;
	}

	/* the panel of the page title, hidden but for screen readers */
	:global(main:has(.demo-frame) .content-panel:not(:has(.demo-frame))) {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	:global(main:has(.demo-frame) .content-panel:has(.demo-frame)) {
		flex: 1;
		min-height: 0;
		padding: 0;
		border-top: 0;
	}

	:global(main:has(.demo-frame) .sl-container) {
		max-width: none;
	}

	:global(.sl-container:has(.demo-frame)),
	:global(.sl-markdown-content:has(.demo-frame)) {
		height: 100%;
	}

	:global(.sl-container:has(.demo-frame) > .site-footer) {
		display: none;
	}

	.demo-frame {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		background: #000;
	}
</style>
