---
// The header's links: Documentation, marked current on every page but the
// home page, followed by Starlight's social icons. Starlight shows this
// component in the header on wide screens and in the mobile menu.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${home}getting-started/installation/`;
const inDocs = Astro.url.pathname !== home;
---

<a class="docs-link" href={docs} aria-current={inDocs ? 'page' : undefined}>Documentation</a>
<Default />

<style>
	.docs-link {
		margin-inline-end: 0.5rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	.docs-link:hover,
	.docs-link[aria-current='page'] {
		color: var(--sl-color-white);
	}
</style>
